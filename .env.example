# Copy this file to .env and fill in real values. Never commit .env.

# --- IPRoyal proxy credentials -----------------------------------------
PROXY_ENABLED=true
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USERNAME=
IPROYAL_PASSWORD=
IPROYAL_PROTOCOL=http
# Optional: country targeting / sticky session prefix, per IPRoyal dashboard docs.
IPROYAL_COUNTRY=us
IPROYAL_SESSION_PREFIX=bbb

# --- HTTP client ---------------------------------------------------------
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5
HTTP_MIN_DELAY_SECONDS=1.0
HTTP_MAX_DELAY_SECONDS=3.0

# --- Storage ---------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false

# --- Output sinks (comma separated): csv, excel, sql, json, http, null -------
OUTPUT_SINKS=csv
CSV_OUTPUT_PATH=data/processed/businesses.csv
EXCEL_OUTPUT_PATH=data/processed/businesses.xlsx
SQL_DATABASE_URL=
SQL_TABLE_NAME=bbb_businesses
HTTP_SINK_URL=
