# Copy this file to .env and fill in real values. Never commit .env.

# --- Proxy credentials ----------------------------------------------------
# Provider-agnostic -- works with Decodo, IPRoyal, or any provider that
# hands out plain username/password + host/port. No code changes needed to
# switch providers, just these values.
#
# Confirmed against Decodo (2026-08-31): country targeting is done via
# HOSTNAME, not a username suffix -- e.g. us.decodo.com routes through a US
# exit node, gate.decodo.com is undirected/random-country. PROXY_USERNAME/
# PROXY_PASSWORD can be left blank if your IP is whitelisted with your
# provider (no credentials needed in the proxy URL at all in that case).
PROXY_ENABLED=true
PROXY_HOST=us.decodo.com
PROXY_PORT=10001
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_PROTOCOL=http
# Unverified/provider-dependent: some providers additionally support
# embedding sticky-session / country targeting into the username instead of
# (or in addition to) a country-specific hostname. Leave unset unless you've
# confirmed your provider actually supports this -- see
# bbb_scraper/scraping/proxies.py.
PROXY_COUNTRY=
PROXY_SESSION_PREFIX=bbb

# --- HTTP client ---------------------------------------------------------
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5
HTTP_MIN_DELAY_SECONDS=1.0
HTTP_MAX_DELAY_SECONDS=3.0

# --- Storage ---------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# --- Reference data ----------------------------------------------------------
# BBB industry/category taxonomy used to drive category-based search.
# See scripts/fetch_categories.py.
CATEGORIES_FILE=data/reference/categories.json

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false

# --- Output sinks (comma separated): csv, excel, sql, json, http, null -------
OUTPUT_SINKS=csv
CSV_OUTPUT_PATH=data/processed/businesses.csv
EXCEL_OUTPUT_PATH=data/processed/businesses.xlsx
SQL_DATABASE_URL=
SQL_TABLE_NAME=bbb_businesses
HTTP_SINK_URL=
