# Copy this file to .env and fill in real values. Never commit .env.

# --- Proxy credentials ----------------------------------------------------
# Provider-agnostic -- works with Decodo, IPRoyal, or any provider that
# hands out plain username/password + host/port. No code changes needed to
# switch providers, just these values.
#
# Confirmed against Decodo (2026-08-31): country targeting is done via
# HOSTNAME, not a username suffix -- e.g. us.decodo.com routes through a US
# exit node, gate.decodo.com is undirected/random-country. PROXY_USERNAME/
# PROXY_PASSWORD can be left blank if your IP is whitelisted with your
# provider (no credentials needed in the proxy URL at all in that case).
PROXY_ENABLED=true
PROXY_HOST=us.decodo.com
PROXY_PORT=10001
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_PROTOCOL=http
# Unverified/provider-dependent: some providers additionally support
# embedding sticky-session / country targeting into the username instead of
# (or in addition to) a country-specific hostname. Leave unset unless you've
# confirmed your provider actually supports this -- see
# bbb_scraper/scraping/proxies.py.
PROXY_COUNTRY=
PROXY_SESSION_PREFIX=bbb

# --- HTTP client ---------------------------------------------------------
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5
HTTP_MIN_DELAY_SECONDS=1.0
HTTP_MAX_DELAY_SECONDS=3.0
# Browser TLS/HTTP2 fingerprint curl_cffi impersonates (see scraping/client.py).
# Confirmed 2026-09-02: needed to get past Cloudflare on BBB business-profile
# pages, where cookie/header replay alone wasn't enough. Valid values are
# curl_cffi's supported targets (e.g. chrome131, chrome146, chrome150, edge101,
# safari184, firefox135, ...) -- check your installed curl_cffi version for
# its current list. Leave as-is unless you have a specific reason to change it.
HTTP_IMPERSONATE=chrome150

# --- Storage ---------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# --- Reference data ----------------------------------------------------------
# BBB industry/category taxonomy used to drive category-based search.
# See scripts/fetch_categories.py.
CATEGORIES_FILE=data/reference/categories.json
# Every US incorporated place + CDP, real lat/lon + population -- powers
# area/metro coverage search. See scripts/build_us_cities.py.
US_CITIES_FILE=data/reference/us_cities.csv
# Curated major-metro list for --metro / the Batch Scraper page.
METROS_FILE=data/reference/metros.json

# --- BBB request settings -----------------------------------------------------
# Session cookies/headers captured from a real browser -- copy
# data/secrets/bbb_session.example.json to data/secrets/bbb_session.json (real
# file is gitignored) and fill in real values. See bbb_scraper/scraping/session.py
# for why this is needed and its expiry/IP-binding caveats.
BBB_SESSION_FILE=data/secrets/bbb_session.json
BBB_SEARCH_URL=https://www.bbb.org/api/search
BBB_FIND_COUNTRY=USA
# BBB caps results at 300 (15 pages x 20) per search -- don't raise this
# expecting more back, it just wastes requests past page 15.
BBB_MAX_SEARCH_PAGES=15

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false

# --- Output sinks (comma separated): csv, excel, sql, json, http, null -------
OUTPUT_SINKS=csv
CSV_OUTPUT_PATH=data/processed/businesses.csv
EXCEL_OUTPUT_PATH=data/processed/businesses.xlsx
SQL_DATABASE_URL=
SQL_TABLE_NAME=bbb_businesses
HTTP_SINK_URL=

# --- Reference data build (one-time, not used by the running app) -----------
# Only needed to regenerate data/reference/us_cities.csv (see
# scripts/build_us_cities.py) -- free signup, no cost:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- Static site deployment (scripts/deploy_site.py only) --------------------
# Not credentials -- just identifiers. Real AWS access comes from the AWS
# CLI's own local config (`aws configure`), a scoped IAM user -- see
# site/DEPLOY.md's "Automating updates" section.
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
